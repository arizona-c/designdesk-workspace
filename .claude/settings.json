{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash sync.sh --if-stale"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash sync.sh"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}